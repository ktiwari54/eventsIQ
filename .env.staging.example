# EventIQ staging (Vercel + Neon + Upstash). Set these in the Vercel project's
# Environment Variables (Preview/Production), not committed to the repo.

# ---- Core (required) ----
DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/eventiq?sslmode=require"
REDIS_URL="rediss://default:PASS@xxx.upstash.io:6379"
NODE_ENV="production"

# ---- Auth (required) ----
NEXTAUTH_URL="https://your-staging.vercel.app"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
# SSO (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID="common"

# ---- Cron (required for scheduled reports on serverless) ----
CRON_SECRET="generate-a-random-string"

# ---- Encryption (recommended) — secrets at rest (Zoho tokens, PII) ----
# openssl rand -hex 32
ENCRYPTION_KEY=""

# ---- AI Copilot / OCR (optional) ----
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ---- Zoho CRM (optional) ----
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_ACCOUNTS_URL="https://accounts.zoho.com"
ZOHO_REDIRECT_URI="https://your-staging.vercel.app/api/zoho/oauth/callback"
ZOHO_WEBHOOK_SECRET=""

# ---- Storage S3 (optional) ----
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="eventiq-staging-uploads"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ---- Email (optional) ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="EventIQ Staging <no-reply@eventiq.app>"

# ---- Observability (optional) ----
SENTRY_DSN=""
METRICS_TOKEN=""
