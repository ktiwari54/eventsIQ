# ---- Core ----
DATABASE_URL="postgresql://eventiq:eventiq@localhost:5432/eventiq"
REDIS_URL="redis://localhost:6379"
NODE_ENV="development"

# ---- Auth (NextAuth / Auth.js) ----
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID="common"

# ---- AI Copilot ----
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ---- Zoho CRM ----
ZOHO_WEBHOOK_SECRET=""
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_ACCOUNTS_URL="https://accounts.zoho.com"
ZOHO_REDIRECT_URI="http://localhost:3000/api/zoho/oauth/callback"

# ---- Storage (AWS S3) ----
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="eventiq-uploads"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ---- Email (SMTP) — optional; no-op when unset ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="EventIQ <no-reply@eventiq.app>"

# ---- Observability ----
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""
# If set, /api/metrics requires Authorization: Bearer <token>
METRICS_TOKEN=""
